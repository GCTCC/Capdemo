    \uD610\uC758 20\uB300 \uB0A8\uC131 \uC5F0\uD589 <alpha=#B0>\xB7 \uBBF8\uC778\uC99D
    \uC74C\uBC18 300\uC5EC \uC7A5 \uC555\uC218<alpha=#FF>            <color=#FFB45C>[\uC758\uD639]</color> 
    \uACF5\uC5C5\uC9C0\uB300 \uD601\uBA85 \uB2F9\uC2DC \uC2E4\uC885\uC790 \uBA85\uB2E8
    \uBE44\uACF5\uAC1C \uB17C\uB780 <alpha=#B0>\xB7 \uC624\uD1A0\uB124 \"\uADFC\uAC70
    \uC5C6\uB294 \uC18C\uBB38\"<alpha=#FF>            <color=#5AE8FF>[\uC7AC\uAC1C\uBC1C]</color> 
