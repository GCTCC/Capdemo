  m_text: "<color=#FF4D5E>[\uC18D\uBCF4]</color>  4\uBC88 \uBD80\uB450 \uBB3C\uB958\uCC3D\uACE0\uC11C
    \uC57C\uAC04\uC870 \uB178\uB3D9\uC790 \uC228\uC9C4 \uCC44 \uBC1C\uACAC <alpha=#B0>\xB7
    \uACBD\uCC30 \"\uB2E8\uC21C \uCD94\uB77D\uC0AC\uACE0\uB85C \uCD94\uC815\"<alpha=#FF>           
    <color=#5AE8FF>[\uC624\uD1A0\uB124 \uACF5\uACF5\uBC29\uC1A1]</color>  7\uAD6C\uC5ED
    \uACF5\uC5C5\uB2E8\uC9C0 \uC624\uB298 \uBC24 \uACC4\uD68D \uC815\uC804 <alpha=#B0>\xB7
    \uBC1C\uC804 \uC124\uBE44 \uC815\uBE44, \uC0DD\uC0B0\uC2DC\uC124 \uC804\uB825
    \uC6B0\uC120 \uACF5\uAE09<alpha=#FF>            <color=#FFB45C>[\uCE58\uC548]</color> 
    \uBB38\uD654\uAD00\uB9AC\uAD6D, \uBBF8\uD5C8\uAC00 \uACF5\uC5F0\uC7A5 \uC9D1\uC911
    \uB2E8\uC18D <alpha=#B0>\xB7 \"\uC778\uC99D\uB418\uC9C0 \uC54A\uC740 \uC74C\uC6D0
    \uC720\uD1B5\uC740 \uACF5\uACF5\uC9C8\uC11C \uC704\uBC18\"<alpha=#FF>           
    <color=#FF4D5E>[\uC0AC\uAC74]</color>  \uC9C0\uD558 \uC74C\uBC18 \uAC70\uB798
    \uD610\uC758 20\uB300 \uB0A8\uC131 \uC5F0\uD589 <alpha=#B0>\xB7 \uBBF8\uC778\uC99D
    \uC74C\uBC18 300\uC5EC \uC7A5 \uC555\uC218<alpha=#FF>            <color=#FFB45C>[\uC758\uD639]</color> 
    \uACF5\uC5C5\uC9C0\uB300 \uD601\uBA85 \uB2F9\uC2DC \uC2E4\uC885\uC790 \uBA85\uB2E8
    \uBE44\uACF5\uAC1C \uB17C\uB780 <alpha=#B0>\xB7 \uC624\uD1A0\uB124 \"\uADFC\uAC70
    \uC5C6\uB294 \uC18C\uBB38\"<alpha=#FF>            <color=#5AE8FF>[\uC7AC\uAC1C\uBC1C]</color> 
    3\uAD6C\uC5ED \uB178\uD6C4 \uB178\uB3D9\uC790 \uC8FC\uAC70\uC9C0 \uCCA0\uAC70
    \uACF5\uACE0 <alpha=#B0>\xB7 \uC8FC\uBBFC \uC774\uC8FC \uAE30\uD55C \uC774\uB2EC
    \uB9D0\uAE4C\uC9C0<alpha=#FF>            <color=#FF4D5E>[\uC0AC\uAC74]</color> 
    \uD3D0\uACF5\uC7A5 \uC9C0\uB300\uC11C \uC2E0\uC6D0 \uBBF8\uC0C1 \uC2DC\uC2E0
    \uBC1C\uACAC <alpha=#B0>\xB7 \uCD5C\uADFC \uC2E4\uC885 \uC2E0\uACE0\uB41C \uC74C\uC545\uAC00
    \uC5EC\uBD80 \uD655\uC778 \uC911<alpha=#FF>            <color=#5AE8FF>[\uC624\uD1A0\uB124]</color> 
    \"\uC7AC\uAC74 30\uC8FC\uB144, \uC9C8\uC11C\uAC00 \uB3C4\uC2DC\uB97C \uC9C0\uCF30\uC2B5\uB2C8\uB2E4\"
    <alpha=#B0>\xB7 \uC624\uD1A0\uB124 \uD64D\uBCF4\uC2E4 \uD2B9\uBCC4 \uB2F4\uD654<alpha=#FF>           
    <color=#A3EBD6>[\uB0A0\uC528]</color>  \uC624\uB298 \uBC24 \uC0B0\uC131\uBE44
    <alpha=#B0>\xB7 \uACF5\uC5C5\uC9C0\uB300 \uC8FC\uBBFC \uC678\uCD9C \uC790\uC81C
    \uAD8C\uACE0<alpha=#FF>            "
