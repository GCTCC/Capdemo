    \uACF5\uACE0 <alpha=#B0>\xB7 \uC8FC\uBBFC \uC774\uC8FC \uAE30\uD55C \uC774\uB2EC
    \uB9D0\uAE4C\uC9C0<alpha=#FF>            <color=#FF4D5E>[\uC0AC\uAC74]</color> 
