    \uACBD\uCC30 \"\uB2E8\uC21C \uCD94\uB77D\uC0AC\uACE0\uB85C \uCD94\uC815\"<alpha=#FF>           
    <color=#5AE8FF>[\uC624\uD1A0\uB124 \uACF5\uACF5\uBC29\uC1A1]</color>  7\uAD6C\uC5ED
    \uACF5\uC5C5\uB2E8\uC9C0 \uC624\uB298 \uBC24 \uACC4\uD68D \uC815\uC804 <alpha=#B0>\xB7
    \uBC1C\uC804 \uC124\uBE44 \uC815\uBE44, \uC0DD\uC0B0\uC2DC\uC124 \uC804\uB825
    \uC6B0\uC120 \uACF5\uAE09<alpha=#FF>            <color=#FFB45C>[\uCE58\uC548]</color> 
    \uBB38\uD654\uAD00\uB9AC\uAD6D, \uBBF8\uD5C8\uAC00 \uACF5\uC5F0\uC7A5 \uC9D1\uC911
    \uB2E8\uC18D <alpha=#B0>\xB7 \"\uC778\uC99D\uB418\uC9C0 \uC54A\uC740 \uC74C\uC6D0
    \uC720\uD1B5\uC740 \uACF5\uACF5\uC9C8\uC11C \uC704\uBC18\"<alpha=#FF>           
